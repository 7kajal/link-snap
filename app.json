{
  "expo": {
    "name": "LinkSnap",
    "slug": "link-snap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "linkcard",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.kajalyadav.linksnap",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "LinkSnap needs photo library access to share story cards to Instagram and Facebook.",
        "NSPhotoLibraryAddUsageDescription": "LinkSnap saves shared story cards to your photo library when sharing."
      }
    },
    "android": {
      "package": "com.kajalyadav.linksnap",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      [
        "react-native-share",
        {
          "ios": [
            "instagram",
            "fb"
          ],
          "android": [
            "com.instagram.android",
            "com.whatsapp",
            "com.whatsapp.w4b",
            "com.facebook.katana"
          ]
        }
      ],
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "ytWorkerUrl": "",
      "fbAppId": "",
      "router": {}
    }
  }
}
